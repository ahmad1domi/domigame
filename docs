<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>لعبة تحدي الأشكال</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      background: #f0f0f0;
      overflow: hidden;
    }
    .screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      width: 100%;
      height: 100vh;
      padding: 20px;
    }
    button {
      padding: 10px 20px;
      margin: 10px;
      font-size: 1rem;
      cursor: pointer;
    }
    #languageToggle {
      position: absolute;
      top: 10px;
      right: 10px;
    }
    #languageToggle button {
      margin-left: 5px;
    }
    .reward-banner {
      font-weight: bold;
      font-size: 1.2rem;
      margin-bottom: 15px;
    }
    #taskArea {
      width: 90%;
      height: 60vh;
      position: relative;
      background: #fff;
      border: 2px dashed #ccc;
      margin-bottom: 15px;
      overflow: hidden;
    }
    #timer, #feedback, #levelInfo {
      font-size: 1.5rem;
      margin: 10px;
    }
    .shape {
      position: absolute;
      cursor: pointer;
    }
    .square {
      width: 50px;
      height: 50px;
      background-color: #3498db;
    }
    .circle {
      width: 50px;
      height: 50px;
      background-color: #e74c3c;
      border-radius: 50%;
    }
    .triangle {
      width: 0;
      height: 0;
      border-left: 25px solid transparent;
      border-right: 25px solid transparent;
      border-bottom: 50px solid #f1c40f;
    }
    .tree {
      font-size: 2rem;
      line-height: 1;
    }
    @keyframes moveShape {
      0%   { transform: translate(0, 0); }
      25%  { transform: translate(10px, -10px); }
      50%  { transform: translate(-10px, 10px); }
      75%  { transform: translate(10px, 10px); }
      100% { transform: translate(0, 0); }
    }
    .moving {
      animation: moveShape 4s ease-in-out infinite;
    }
    #levelCompleteScreen, #finalScreen {
      background: #fff;
      padding: 30px;
      border: 2px solid #ccc;
      border-radius: 8px;
    }
    .level-bg-1 { background: #d0f0fd; }
    .level-bg-2 { background: #fdded0; }
    .level-bg-3 { background: #d0fdd8; }
    .level-bg-4 { background: #fdd0f0; }
    .level-bg-5 { background: #fefcd7; }
    .level-bg-6 { background: #d7e0fd; }
    .level-bg-7 { background: #ffd7d7; }
    .level-bg-8 { background: #d7ffd7; }
    .level-bg-9 { background: #d7d7ff; }
    .level-bg-10 { background: #fff0d7; }
  </style>
</head>
<body>
  <div id="homeScreen" class="screen">
    <h1>لعبة تحدي الأشكال</h1>
    <button id="startGameBtn"></button>
    <div id="languageToggle">
      <button data-lang="en">English</button>
      <button data-lang="ar">العربية</button>
    </div>
  </div>
  
  <div id="gameScreen" class="screen" style="display: none;">
    <div id="rewardBanner" class="reward-banner"></div>
    <div id="levelInfo"></div>
    <div id="taskArea"></div>
    <div id="timer"></div>
    <div id="feedback"></div>
  </div>
  
  <div id="levelCompleteScreen" class="screen" style="display: none;">
    <h2 id="levelCompleteMessage"></h2>
    <p id="motivationalMessage"></p>
    <button id="continueBtn"></button>
  </div>
  
  <div id="finalScreen" class="screen" style="display: none;">
    <h2 id="finalMessage"></h2>
    <p id="rewardCodeMessage"></p>
  </div>
  
  <audio id="tickSound" src="tick.mp3"></audio>
  <audio id="rewardSound" src="reward.mp3"></audio>
  <audio id="failSound" src="fail.mp3"></audio>
  
  <script>
    const TOTAL_LEVELS = 10;
    const TASKS_PER_LEVEL = 10;
    let currentLevel = 1;
    let currentTask = 0;
    let language = 'ar';
    let levelTimer;
    let timeRemaining = 0;
  
    const tickSound = document.getElementById("tickSound");
    const rewardSound = document.getElementById("rewardSound");
    const failSound = document.getElementById("failSound");
  
    const texts = {
      en: {
        startGame: "Start Game",
        banner: "🔥 Beat all 10 levels to win a $10 prize! Only one winner out of every 10,000 players will get the prize. Try your luck!",
        congratulations: "Congratulations! You passed Level ",
        motivational: "You're closer to the $10 prize!",
        continue: "Continue to Level ",
        finalCongrats: "🎉 Congratulations! You beat all 10 levels.",
        claimReward: "Send this code to claim your $10 reward.",
        failed: "Time's up! Try again.",
        reload: "Reload",
        restart: "Restart Game"
      },
      ar: {
        startGame: "ابدأ اللعبة",
        banner: "🔥 تغلب على جميع المستويات العشرة للفوز بجائزة 10 دولارات! الفائز واحد فقط من بين كل 10,000 لاعب. جرب حظك!",
        congratulations: "تهانينا! لقد نجحت في المستوى ",
        motivational: "أنت تقترب من جائزة 10 دولارات!",
        continue: "استمر إلى المستوى ",
        finalCongrats: "🎉 تهانينا! لقد أكملت جميع المستويات العشرة.",
        claimReward: "أرسل هذا الرمز لتحصيل جائزة 10 دولارات الخاصة بك.",
        failed: "انتهى الوقت! حاول مرة أخرى.",
        reload: "إعادة تحميل",
        restart: "إعادة اللعبة"
      }
    };
  
    const shapes = ["square", "circle", "triangle", "tree"];
  
    // حساب الوقت لكل شكل وفق النقاط المفتاحية:
    // Level 1: 2.00s, Level 2: 1.70s, Level 5: 1.30s, Level 7: 0.70s, Level 10: 0.30s.
    // يتم الاستيفاء الخطي بين هذه النقاط.
    function getTimePerShape(level) {
      if (level <= 1) return 2.00;
      if (level === 2) return 1.70;
      if (level > 2 && level < 5) {
        let fraction = (level - 2) / (5 - 2);
        return 1.70 + fraction * (1.30 - 1.70);
      }
      if (level === 5) return 1.30;
      if (level > 5 && level < 7) {
        let fraction = (level - 5) / (7 - 5);
        return 1.30 + fraction * (0.70 - 1.30);
      }
      if (level === 7) return 0.70;
      if (level > 7 && level < 10) {
        let fraction = (level - 7) / (10 - 7);
        return 0.70 + fraction * (0.30 - 0.70);
      }
      return 0.30;
    }
  
    function randomInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }
  
    function createRandomShape() {
      const taskArea = document.getElementById("taskArea");
      taskArea.innerHTML = "";
      const shapeType = shapes[randomInt(0, shapes.length - 1)];
      const shapeEl = document.createElement("div");
      shapeEl.classList.add("shape", shapeType, "moving");
      if (shapeType === "tree") {
        shapeEl.textContent = "🌳";
      }
      const areaRect = taskArea.getBoundingClientRect();
      const maxLeft = areaRect.width - 60;
      const maxTop = areaRect.height - 60;
      shapeEl.style.left = randomInt(0, maxLeft) + "px";
      shapeEl.style.top = randomInt(0, maxTop) + "px";
      shapeEl.addEventListener("click", () => {
        clearInterval(levelTimer);
        tickSound.currentTime = 0;
        tickSound.play();
        setTimeout(nextChallenge, 300);
      });
      taskArea.appendChild(shapeEl);
    }
  
    function updateTexts() {
      document.getElementById("startGameBtn").textContent = texts[language].startGame;
      document.getElementById("rewardBanner").textContent = texts[language].banner;
      const continueBtn = document.getElementById("continueBtn");
      if (continueBtn) {
        continueBtn.textContent = texts[language].continue;
      }
    }
  
    function setLanguage(newLang) {
      language = newLang;
      updateTexts();
      if (currentScreen === "game") {
        document.getElementById("rewardBanner").textContent = texts[language].banner;
      }
    }
  
    let currentScreen = "home";
    function showScreen(screenId) {
      document.getElementById("homeScreen").style.display = "none";
      document.getElementById("gameScreen").style.display = "none";
      document.getElementById("levelCompleteScreen").style.display = "none";
      document.getElementById("finalScreen").style.display = "none";
      document.getElementById(screenId).style.display = "flex";
      currentScreen = screenId === "homeScreen" ? "home" : (screenId === "gameScreen" ? "game" : currentScreen);
    }
  
    function startGame() {
      currentLevel = 1;
      currentTask = 0;
      showScreen("gameScreen");
      loadLevel();
    }
  
    function loadLevel() {
      const taskArea = document.getElementById("taskArea");
      taskArea.className = "";
      taskArea.classList.add("level-bg-" + currentLevel);
      document.getElementById("levelInfo").textContent = "المستوى " + currentLevel;
      document.getElementById("rewardBanner").textContent = texts[language].banner;
      document.getElementById("feedback").textContent = "";
      currentTask = 0;
      setTimeout(startChallenge, 500);
    }
  
    function startChallenge() {
      if (currentTask >= TASKS_PER_LEVEL) {
        levelComplete();
        return;
      }
      document.getElementById("taskArea").innerHTML = "";
      const timePerShape = getTimePerShape(currentLevel);
      timeRemaining = timePerShape;
      document.getElementById("timer").textContent = timeRemaining.toFixed(2) + "s";
      createRandomShape();
      clearInterval(levelTimer);
      levelTimer = setInterval(() => {
        timeRemaining -= 0.1;
        document.getElementById("timer").textContent = timeRemaining.toFixed(2) + "s";
        if (timeRemaining <= 0) {
          lostLevel();
        }
      }, 100);
      currentTask++;
    }
  
    function nextChallenge() {
      setTimeout(startChallenge, 300);
    }
  
    // عند الخسارة يتم تحديد المستوى الهدف كما يلي:
    // إذا كان المستوى 1 أو 2 أو 3 يُعاد للمرحلة 1.
    // إذا كان من المستوى 4 إلى 7 يُعاد للمرحلة 3.
    // إذا كان من المستوى 8 إلى 10 يُعاد للمرحلة 7.
    function lostLevel() {
      clearInterval(levelTimer);
      failSound.currentTime = 0;
      failSound.play();
      let targetLevel;
      if (currentLevel <= 3) {
        targetLevel = 1;
      } else if (currentLevel >= 8) {
        targetLevel = 7;
      } else {
        targetLevel = 3;
      }
      showScreen("levelCompleteScreen");
      document.getElementById("levelCompleteMessage").textContent = texts[language].failed;
      const continueBtn = document.getElementById("continueBtn");
      if (targetLevel === 1) {
        continueBtn.textContent = texts[language].reload;
      } else {
        continueBtn.textContent = texts[language].restart;
      }
      continueBtn.onclick = () => {
        currentLevel = targetLevel;
        showScreen("gameScreen");
        loadLevel();
      };
    }
  
    function levelComplete() {
      clearInterval(levelTimer);
      if (currentLevel >= TOTAL_LEVELS) {
        showFinalScreen();
        return;
      }
      showScreen("levelCompleteScreen");
      document.getElementById("levelCompleteMessage").textContent = texts[language].congratulations + currentLevel;
      document.getElementById("motivationalMessage").textContent = texts[language].motivational;
      const continueBtn = document.getElementById("continueBtn");
      continueBtn.textContent = texts[language].continue + (currentLevel + 1);
      continueBtn.onclick = () => {
        currentLevel++;
        showScreen("gameScreen");
        loadLevel();
      };
      rewardSound.currentTime = 0;
      rewardSound.play();
    }
  
    function showFinalScreen() {
      showScreen("finalScreen");
      document.getElementById("finalMessage").textContent = texts[language].finalCongrats;
      const winRoll = randomInt(1, 10000);
      if (winRoll === 1) {
        const code = randomInt(100000, 999999);
        document.getElementById("rewardCodeMessage").textContent = code + " - " + texts[language].claimReward;
      } else {
        document.getElementById("rewardCodeMessage").textContent = texts[language].claimReward + " (عذرًا، لم تحصل على جائزة هذه المرة.)";
      }
    }
  
    document.getElementById("startGameBtn").addEventListener("click", startGame);
    document.querySelectorAll("#languageToggle button").forEach(btn => {
      btn.addEventListener("click", () => setLanguage(btn.getAttribute("data-lang")));
    });
  
    updateTexts();
  </script>
</body>
</html>
